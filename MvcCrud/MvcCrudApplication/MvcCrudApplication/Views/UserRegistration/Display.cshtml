@model IEnumerable<MvcCrudApplication.Models.UserReg>

@{
    ViewBag.Title = "Display";
}

<h2>Display</h2>

<p>
    @Html.ActionLink("Create New", "Save", "UserRegistration")
</p>
<table class="table">
    <tr>
